# Copy to .env.local for local development. See docs/env.md for every variable.
# NEXT_PUBLIC_* values are shipped to browsers: never put a secret in one.

APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# From `pnpm exec supabase status` (local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Bypasses RLS; used only by src/server/privileged.
SUPABASE_SECRET_KEY=

# Must equal SEND_SMS_HOOK_SECRET in supabase/.env (generate: echo "v1,whsec_$(openssl rand -base64 32)")
SEND_SMS_HOOK_SECRET=

# Providers: only `mock` exists until real vendors are integrated (Phase 8/9). Refused in production.
SMS_PROVIDER=mock

# Default region for parsing phone numbers typed without a country code
DEFAULT_COUNTRY_CODE=GH
# Phase 8: WhatsApp and email providers (mock until vendors are chosen; refused in production)
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock
# Bearer secret for /api/internal/jobs/dispatch: openssl rand -hex 32
CRON_SECRET=

